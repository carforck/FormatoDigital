# Copia este archivo como .env.local (no se sube al repositorio) y completa los valores.
# Sin las variables de Supabase la app funciona igual en modo demo (localStorage).

# Supabase (Settings → API). La llave publishable es pública: la protege RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo servidor (nunca en el navegador ni en el repo): la usa /api/usuarios.
SUPABASE_SECRET_KEY=

# URL pública del sitio (metadatos y Open Graph). Opcional: si falta se usa la de producción.
# No la dejes vacía (una cadena vacía rompe metadataBase).
# NEXT_PUBLIC_SITE_URL=https://controlone.sotecse.com

# Reservada para el envío de correo con Resend (aún no se usa en el código).
RESEND_API_KEY=

# Solo para scripts/aplicar-migracion.py (Management API de Supabase); no las usa la app.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
